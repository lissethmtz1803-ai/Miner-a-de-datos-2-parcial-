      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# 7: MÉTODO DEL CODO\n",
        "\n",
        "# Este apartado aplica el método del codo para determinar el número\n",
        "# óptimo de grupos (clusters) calculando la inercia (suma de distancias al cuadrado).\n",
        "\n",
        "# Lista para almacenar los valores de inercia de cada modelo\n",
        "inercias = []\n",
        "\n",
        "# Probar distintas cantidades de clusters (de 1 a 10)\n",
        "for k in range(1, 11):\n",
        "    modelo = KMeans(\n",
        "        n_clusters=k,\n",
        "        random_state=42,\n",
        "        n_init=10\n",
        "    )\n",
        "    # Entrenar el modelo con los datos normalizados\n",
        "    modelo.fit(X_escalado)\n",
        "\n",
        "    # Guardar la inercia obtenida para k clusters\n",
        "    inercias.append(modelo.inertia_)\n",
        "\n",
        "# Graficar los resultados de la inercia vs. el número de clusters (K)\n",
        "plt.figure(figsize=(6, 4))\n",
        "plt.plot(range(1, 11), inercias, marker='o')\n",
        "plt.xlabel(\"Número de clusters (K)\")\n",
        "plt.ylabel(\"Inercia\")\n",
        "plt.title(\"Método del Codo\")\n",
        "plt.grid(True)\n",
        "plt.show()"
      ],
