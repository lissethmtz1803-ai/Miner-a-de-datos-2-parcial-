    {
      "cell_type": "code",
      "source": [
        "# 6: NORMALIZACIÓN\n",
        "\n",
        "# Este apartado hace que todas las variables tengan la\n",
        "# misma escala para que ninguna influya más que otra.\n",
        "\n",
        "escalador = StandardScaler()\n",
        "\n",
        "X_escalado = escalador.fit_transform(X)"
      ],
